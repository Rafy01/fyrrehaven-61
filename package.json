    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "busboy": "^1.6.0",
    "formidable": "^3.5.4",
    "googleapis": "^159.0.0",
    "i18next": "^25.4.2",
    "next": "^15.5.2",
    "nodemailer": "^7.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
