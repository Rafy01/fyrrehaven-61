# Production site URL for canonical/OG tags (no trailing slash)
VITE_SITE_URL=https://fyrrehaven-61.dk

# Google reCAPTCHA Classic v2 checkbox
# Create keys in Google reCAPTCHA Admin Console for fyrrehaven-61.dk.
# Leave these empty if you use reCAPTCHA Enterprise instead.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_ALLOWED_HOSTNAMES=fyrrehaven-61.dk,www.fyrrehaven-61.dk

# Google reCAPTCHA Enterprise score-based key
# Use these when your key comes from Google Cloud reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-enterprise-site-key
RECAPTCHA_ENTERPRISE_SITE_KEY=your-enterprise-site-key
RECAPTCHA_ENTERPRISE_PROJECT_ID=your-google-cloud-project-id
RECAPTCHA_ENTERPRISE_API_KEY=your-google-cloud-api-key
RECAPTCHA_ENTERPRISE_ACTION=human_verification
RECAPTCHA_ENTERPRISE_SCORE_THRESHOLD=0.5

# SMTP mail delivery for contact and check-in forms
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=kontakt@fyrrehaven-61.dk
SMTP_PASS=your-mailbox-password
MAIL_FROM=kontakt@fyrrehaven-61.dk
MAIL_TO=kontakt@fyrrehaven-61.dk

# Private booking calendar feed
ICAL_URL=your-private-calendar-url
