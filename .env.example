# Production site URL for canonical/OG tags (no trailing slash)
VITE_SITE_URL=https://fyrrehaven-61.dk

# Firebase client config for the admin dashboard
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase admin config for storing and reading submissions on the server
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ALLOWED_ADMIN_EMAILS=admin@example.com

# Google Search Console HTML tag verification token
VITE_GOOGLE_SITE_VERIFICATION=

# Optional Google Analytics 4 measurement ID (loaded only after statistics consent)
VITE_GA_MEASUREMENT_ID=

# SMTP mail delivery for contact and check-in forms
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=kontakt@fyrrehaven-61.dk
SMTP_PASS=your-mailbox-password
MAIL_FROM=kontakt@fyrrehaven-61.dk
MAIL_TO=kontakt@fyrrehaven-61.dk

# Optional security tuning for form endpoints
CONTACT_RATE_LIMIT=10
CONTACT_RATE_WINDOW_MS=3600000
CONTACT_MIN_FORM_FILL_MS=1500
CONTACT_MAX_FORM_AGE_MS=43200000
CHECKIN_MAX_UPLOAD_FILES=4
CHECKIN_MAX_UPLOAD_FILE_SIZE_MB=8
CHECKIN_MAX_TOTAL_UPLOAD_SIZE_MB=20
EXPOSE_INTERNAL_API_ERRORS=false

# Private booking calendar feed
ICAL_URL=your-private-calendar-url
