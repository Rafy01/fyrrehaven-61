# Production site URL for canonical/OG tags (no trailing slash)
VITE_SITE_URL=https://fyrrehaven-61.dk

# Google reCAPTCHA v2 checkbox
# Create keys in Google reCAPTCHA Admin Console for fyrrehaven-61.dk
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_ALLOWED_HOSTNAMES=fyrrehaven-61.dk,www.fyrrehaven-61.dk

# SMTP mail delivery for contact and check-in forms
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=kontakt@fyrrehaven-61.dk
SMTP_PASS=your-mailbox-password
MAIL_FROM=kontakt@fyrrehaven-61.dk
MAIL_TO=kontakt@fyrrehaven-61.dk
