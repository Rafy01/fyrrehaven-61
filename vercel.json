{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api).*)", "destination": "/" }
  ]
    ,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "test.fyrrehaven-61.dk" }],
      "headers": [{ "key": "x-robots-tag", "value": "noindex, nofollow" }]
    }
  ]
}