{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "test.fyrrehaven-61.dk" }],
      "headers": [{ "key": "x-robots-tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:asset*\\.(css|js|map|png|jpg|jpeg|svg|webp|gif|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
